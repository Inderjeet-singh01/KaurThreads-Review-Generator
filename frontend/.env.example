# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Base URL of the FastAPI backend that exposes POST /generate-review.
# No trailing slash. Do NOT hardcode this anywhere in the source.
#   Local dev example:  http://127.0.0.1:8000
#   Production example: https://api.kaurthreads.example.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Kaur Threads Boutique's public Google "write a review" link, opened by
# "Post on Google" after the review is copied to the clipboard. The customer
# pastes and submits the review themselves — the app never posts to Google.
VITE_GOOGLE_REVIEW_URL=https://search.google.com/local/writereview?placeid=ChIJXfSGFKDvDzkRaANBXxmg1Z8
