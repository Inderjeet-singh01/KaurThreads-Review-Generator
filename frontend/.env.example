# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Base URL of the FastAPI backend that exposes POST /generate-review.
# No trailing slash. Do NOT hardcode this anywhere in the source.
#   Local dev example:  http://127.0.0.1:8000
#   Production example: https://api.kaurthreads.example.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Google Maps Universal URL for Kaur Threads Boutique, opened by "Post on
# Google" after the review is copied to the clipboard. The customer pastes and
# submits the review themselves — the app never posts to Google.
VITE_GOOGLE_MAPS_URL=https://www.google.com/maps/search/?api=1&query=Kaur+Threads+Boutique&query_place_id=ChIJXfSGFKDvDzkRaANBXxmg1Z8

# Legacy — kept for backward compatibility, NOT used by "Post on Google".
VITE_GOOGLE_REVIEW_URL=
