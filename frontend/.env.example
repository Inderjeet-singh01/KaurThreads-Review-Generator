# Copy this file to `.env` and fill in real values. Never commit `.env`.

# Base URL of the FastAPI backend that exposes POST /generate-review.
# No trailing slash. Do NOT hardcode this anywhere in the source.
#   Local dev example:  http://127.0.0.1:8000
#   Production example: https://api.kaurthreads.example.com
VITE_API_BASE_URL=http://127.0.0.1:8000

# Kaur Threads Boutique's public Google "write a review" link. The customer
# submits the review themselves on Google — the app only opens this URL.
# Build it from the Google Place ID:
#   https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
VITE_GOOGLE_REVIEW_URL=
