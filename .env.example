# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Groq (https://console.groq.com/keys) ---------------------------------
# Reuses the SAME key/model as the Review Reply AI project.
GROQ_API_KEY=

# Optional: Groq model used for review generation.
GROQ_MODEL=openai/gpt-oss-120b

# --- Google review page ---------------------------------------------------
# Kaur Threads Boutique's public "write a review" link. The customer submits
# the review themselves on Google using this URL — the backend never posts to
# Google, so no OAuth is required. Build it from the Google Place ID:
#   https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
GOOGLE_REVIEW_URL=

# --- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API (future frontend).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
