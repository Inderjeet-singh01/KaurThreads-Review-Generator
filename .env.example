# Copy this file to `.env` and fill in real values. Never commit `.env`.

# --- Groq (https://console.groq.com/keys) ---------------------------------
# Reuses the SAME key/model as the Review Reply AI project.
GROQ_API_KEY=

# Optional: Groq model used for review generation.
GROQ_MODEL=openai/gpt-oss-120b

# --- Gemini fallback (https://aistudio.google.com/apikey) ------------------
# Used only when a Groq call fails for a transient reason (rate limit,
# timeout, network, 5xx). Leave empty to disable the fallback.
GEMINI_API_KEY=

# Optional: Gemini model used for the fallback.
GEMINI_MODEL=gemini-3.8-flash

# --- Google review page ---------------------------------------------------
# Kaur Threads Boutique's public "write a review" link. The customer submits
# the review themselves on Google using this URL — the backend never posts to
# Google, so no OAuth is required. Build it from the Google Place ID:
#   https://search.google.com/local/writereview?placeid=YOUR_PLACE_ID
GOOGLE_REVIEW_URL=

# --- Review history ------------------------------------------------------
# Optional: SQLite file of accepted reviews (keeps reviews unique across
# restarts). Defaults to data/review_history.sqlite3. On hosts with an
# ephemeral disk, point this at a persistent disk.
# REVIEW_HISTORY_PATH=

# --- CORS ------------------------------------------------------------------
# Comma-separated browser origins allowed to call this API (future frontend).
CORS_ALLOW_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173
